-- =================== BUSCA / PAGINAÇÃO LOCAL ===================
local function getSourceList()
    if currentCategory ~= "All" then
        local cat = emoteData.Sets[currentCategory]
        if cat then
            local list = {}
            for _, entry in ipairs(cat.emotes) do
                table.insert(list, {Id = entry.id, AssetId = entry.id, Name = entry.name})
            end
            return list
        end
    end
    return filteredEmotes
end

local function refilterEmotes(term)
    term = tostring(term or ""):lower()
    if term == "" then
        filteredEmotes = allEmotes
        return
    end
    local isId = term:match("^%d+$")
    local out = {}
    for _, e in ipairs(allEmotes) do
        local idStr = tostring(e.id)
        local nameStr = tostring(e.name)
        if isId then
            if idStr == term then table.insert(out, e) end
        else
            if smartSearchMatch(nameStr, term) then table.insert(out, e) end
        end
    end
    filteredEmotes = out
end

loadPage = function(targetPage)
    local source = getSourceList()

    -- Proteção final (não deve ocorrer)
    if #source == 0 then
        source = deepCopy(DEFAULT_EMOTES)
        allEmotes = source
        filteredEmotes = source
    end

    totalPages = math.max(1, math.ceil(#source / 8))
    if targetPage > totalPages then targetPage = totalPages end
    if targetPage < 1 then targetPage = 1 end
    currentPage = targetPage
    pageTextBox.Text = tostring(currentPage)
    pageInfoLabel.Text = tostring(totalPages)

    catalogItems = {}
    local startIndex = (currentPage - 1) * 8 + 1
    for j = 0, 7 do
        local e = source[startIndex + j]
        if e then table.insert(catalogItems, e) end
    end
    updateWheelSlots()
end

prevButton.MouseButton1Click:Connect(function()
    if currentPage > 1 then loadPage(currentPage - 1) end
end)
nextButton.MouseButton1Click:Connect(function()
    if currentPage < totalPages then loadPage(currentPage + 1) end
end)
pageTextBox.FocusLost:Connect(function()
    local n = tonumber(pageTextBox.Text)
    if n then loadPage(math.clamp(n, 1, totalPages)) else pageTextBox.Text = tostring(currentPage) end
end)
searchBox.FocusLost:Connect(function()
    currentKeyword = searchBox.Text
    refilterEmotes(currentKeyword)
    loadPage(1)
end)

