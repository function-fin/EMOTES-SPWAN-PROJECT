local radiusTotal = WHEEL_SIZE / 2
local innerRadius = radiusTotal * CENTER_RATIO
local outerRadius = radiusTotal
local slotLabelRadius = (innerRadius + outerRadius) / 2

local TOTAL_SLOTS = 8

updateWheelSlots = function()
    for i = 1, TOTAL_SLOTS do
        local item = catalogItems[i]
        local btn = slotButtons[i]
        local img = slotImages[i]
        local indicator = selectionIndicators[i]
        
        indicator.Visible = false
        
        if item then
            btn.Text = "" 
            img.Image = "rbxthumb://type=Asset&id=" .. tostring(item.AssetId or item.Id) .. "&w=150&h=150"
            img.Visible = true
        else
            btn.Text = tostring(i)
            img.Image = ""
            img.Visible = false
        end
    end
end

loadPage = function(targetPage)
    task.spawn(function()
        local params = CatalogSearchParams.new()
        params.SearchKeyword = currentKeyword
        params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        params.SortType = Enum.CatalogSortType.RecentlyCreated
        params.Limit = 30
        
        local ok, pages = pcall(function() return AvatarEditorService:SearchCatalog(params) end)
        if ok and pages then
            local batchCount = math.ceil((targetPage * 8) / 30)
            for _ = 1, batchCount - 1 do
                if pages.IsFinished then break end
                pcall(function() pages:AdvanceToNextPageAsync() end)
            end
            
            local successList, list = pcall(function() return pages:GetCurrentPage() end)
            if successList and list then
                catalogItems = {}
                local startIndex = (((targetPage - 1) * 8) % 30) + 1
                
                for j = 1, 8 do
                    local item = list[startIndex + j - 1]
                    if currentCategory == "Favoritos" then
                        local favList = {}
                        for _, v in ipairs(list) do
                            if emoteData.favorites[tostring(v.AssetId or v.Id)] then
                                table.insert(favList, v)
                            end
                        end
                        item = favList[startIndex + j - 1]
                    elseif currentCategory ~= "All" then
                        local catList = {}
                        for _, cat in ipairs(emoteData.categories) do
                            if cat.name == currentCategory then
                                for _, id in ipairs(cat.emotes) do
                                    for _, v in ipairs(list) do
                                        if tostring(v.AssetId or v.Id) == tostring(id) then
                                            table.insert(catList, v)
                                        end
                                    end
                                end
                            end
                        end
                        item = catList[startIndex + j - 1]
                    end
                    
                    if item then
                        table.insert(catalogItems, item)
                    end
                end
                
                currentPage = targetPage
                updateWheelSlots()
            end
        end
    end)
end

for i = 1, TOTAL_SLOTS do
    local slotAngleDeg = ((i - 1) * (360 / TOTAL_SLOTS)) - 90
    local slotAngleRad = math.rad(slotAngleDeg)
    
    local slotX = radiusTotal + (math.cos(slotAngleRad) * slotLabelRadius)
    local slotY = radiusTotal + (math.sin(slotAngleRad) * slotLabelRadius)

    local slotButton = Instance.new("TextButton")
    slotButton.Size = UDim2.new(0, 32, 0, 32)
    slotButton.AnchorPoint = Vector2.new(0.5, 0.5)
    slotButton.Position = UDim2.new(0, slotX, 0, slotY)
    slotButton.BackgroundTransparency = 1
    slotButton.Text = tostring(i)
    slotButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    slotButton.TextSize = 13
    slotButton.Font = Enum.Font.Arcade
    slotButton.ZIndex = 6
    slotButton.Parent = wheelFrame

    local selectionIndicator = Instance.new("Frame")
    selectionIndicator.Size = UDim2.new(1, 6, 1, 6)
    selectionIndicator.AnchorPoint = Vector2.new(0.5, 0.5)
    selectionIndicator.Position = UDim2.new(0.5, 0, 0.5, 0)
    selectionIndicator.BackgroundTransparency = 1
    selectionIndicator.Visible = false
    selectionIndicator.ZIndex = 5
    selectionIndicator.Parent = slotButton
    Instance.new("UICorner", selectionIndicator).CornerRadius = UDim.new(0.5, 0)
    local indStroke = Instance.new("UIStroke")
    indStroke.Color = Color3.fromRGB(255, 255, 255)
    indStroke.Thickness = 2
    indStroke.Parent = selectionIndicator

    local slotImg = Instance.new("ImageLabel")
    slotImg.Size = UDim2.new(1, 0, 1, 0)
    slotImg.BackgroundTransparency = 1
    slotImg.ScaleType = Enum.ScaleType.Fit
    slotImg.ZIndex = 6
    slotImg.Parent = slotButton

    slotButton.MouseButton1Click:Connect(function()
        local item = catalogItems[i]
        if item then
            for _, ind in pairs(selectionIndicators) do
                ind.Visible = false
            end
            selectionIndicator.Visible = true

            selectedEmoteItem = item
            centerText.Text = item.Name or "Emote"
            cartridgeButton.Visible = true
            LoadTrack(item.AssetId or item.Id)
        end
    end)
    
    slotButtons[i] = slotButton
    slotImages[i] = slotImg
    selectionIndicators[i] = selectionIndicator
end

prevButton.MouseButton1Click:Connect(function()
    if currentPage > 1 then
        currentPage = currentPage - 1
        pageTextBox.Text = tostring(currentPage)
        loadPage(currentPage)
    end
end)

nextButton.MouseButton1Click:Connect(function()
    if currentPage < totalPages then
        currentPage = currentPage + 1
        pageTextBox.Text = tostring(currentPage)
        loadPage(currentPage)
    end
end)

pageTextBox.FocusLost:Connect(function()
    local num = tonumber(pageTextBox.Text)
    if num then
        currentPage = math.clamp(num, 1, totalPages)
        pageTextBox.Text = tostring(currentPage)
        loadPage(currentPage)
    else
        pageTextBox.Text = tostring(currentPage)
    end
end)

searchBox.FocusLost:Connect(function()
    currentKeyword = searchBox.Text
    currentPage = 1
    loadPage(currentPage)
end)

buildCategoriesMenu = function()
    for _, child in ipairs(sideScrolling:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local function createCatBtn(name, count)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -4, 0, 24)
        btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        btn.Text = "  " .. name .. "  (" .. count .. ")"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 9
        btn.Font = Enum.Font.Arcade
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = sideScrolling
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        Instance.new("UIStroke", btn).Color = Color3.fromRGB(255, 255, 255)
        
        btn.MouseButton1Click:Connect(function()
            currentCategory = name
            currentPage = 1
            loadPage(currentPage)
            sidePanel.Visible = false
        end)
    end
    
    createCatBtn("All", "Todos")
    local favCount = 0
    for _, _ in pairs(emoteData.favorites) do favCount = favCount + 1 end
    createCatBtn("Favoritos", favCount)
    
    for _, cat in ipairs(emoteData.categories) do
        createCatBtn(cat.name, #cat.emotes)
    end
end

buildCategoriesMenu()
