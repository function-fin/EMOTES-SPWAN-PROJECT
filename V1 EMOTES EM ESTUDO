        local hl = slotHighlights[i]

        if hl then
            TweenService:Create(hl, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        end

        if item then
            txt.Visible = false
            img.Image = "rbxthumb://type=Asset&id=" .. tostring(item.AssetId or item.Id) .. "&w=150&h=150"
            img.Visible = true
        else
            txt.Visible = true
            img.Image = ""
            img.Visible = false
        end
    end
end

-- ==========================================
-- loadPage — Contagem dinâmica de páginas
-- Estratégia: acumula a página atual + 3 páginas seguintes (até 480 itens)
-- Calcula totalPages com base no que achou (estimativa progressiva)
-- ==========================================
loadPage = function(targetPage)
    task.spawn(function()
        local params = CatalogSearchParams.new()
        params.SearchKeyword = currentKeyword
        params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        params.SortType = Enum.CatalogSortType.RecentlyCreated
        params.Limit = 120

        local ok, pages = pcall(function() return AvatarEditorService:SearchCatalog(params) end)
        if ok and pages then
            local allFetched = {}

            -- Página atual
            local s, list = pcall(function() return pages:GetCurrentPage() end)
            if s and list then
                for _, v in ipairs(list) do table.insert(allFetched, v) end
            end

            -- + 3 páginas seguintes
            for _ = 1, 3 do
                if pages.IsFinished then break end
                pcall(function() pages:AdvanceToNextPageAsync() end)
                s, list = pcall(function() return pages:GetCurrentPage() end)
                if s and list then
                    for _, v in ipairs(list) do table.insert(allFetched, v) end
                end
            end

            -- Filtra por categoria (se não for "All")
            local sourceList = allFetched
            if currentCategory ~= "All" then
                local catSet = {}
                for _, cat in ipairs(emoteData.categories) do
                    if cat.name == currentCategory then
                        for _, id in ipairs(cat.emotes) do catSet[tostring(id)] = true end
                        break
                    end
                end
                sourceList = {}
                for _, v in ipairs(allFetched) do
                    if catSet[tostring(v.AssetId or v.Id)] then table.insert(sourceList, v) end
                end
            end

            -- Calcula totalPages
            if #sourceList > 0 then
                if currentKeyword == "" and currentCategory == "All" then
                    totalPages = DEFAULT_TOTAL_PAGES
                else
                    totalPages = math.max(1, math.ceil(#sourceList / 8))
                end
            else
                totalPages = 1
            end

            -- Extrai os 8 emotes da página alvo
            catalogItems = {}
            local startIndex = ((targetPage - 1) * 8) + 1
            for j = 1, 8 do
                if sourceList[startIndex + j - 1] then
                    table.insert(catalogItems, sourceList[startIndex + j - 1])
                end
            end

            updateWheelSlots()
            pageInfoLabel.Text = tostring(totalPages)  -- atualiza contador de páginas
        end
    end)
end

