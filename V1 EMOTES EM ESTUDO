local function promptRenameCategory(oldName, btn)
    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(1, -35, 1, 0)
    textBox.Position = UDim2.new(0, 24, 0, 0)
    textBox.BackgroundTransparency = 1
    textBox.Text = oldName
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.TextSize = 9
    textBox.Font = Enum.Font.Arcade
    textBox.ClearTextOnFocus = false
    textBox.Parent = btn
    
    for _, v in pairs(btn:GetChildren()) do
        if v:IsA("TextLabel") and v.Name ~= "EditBox" and v.Text ~= ">" then v.Visible = false end
    end
    textBox:CaptureFocus()
    
    local finished = false
    local function finishRename(commit)
        if finished then return end
        finished = true
        if commit and textBox.Text ~= "" then
            local newName = textBox.Text
            for _, cat in ipairs(emoteData.categories) do
                if cat.name == oldName then cat.name = newName break end
            end
            if currentCategory == oldName then currentCategory = newName end
        end
        textBox:Destroy()
        buildCategoriesMenu() 
    end
    
    textBox.FocusLost:Connect(function(enterPressed)
        finishRename(enterPressed)
    end)
end

createCatGlobalBtn.MouseButton1Click:Connect(function()
    table.insert(emoteData.categories, { name = "Nova Cat " .. (#emoteData.categories + 1), emotes = {} })
    buildCategoriesMenu()
end)

removeCatGlobalBtn.MouseButton1Click:Connect(function()
    if currentCategory == "All" then return end
    for i, cat in ipairs(emoteData.categories) do
        if cat.name == currentCategory then
            table.remove(emoteData.categories, i)
            currentCategory = "All"
            break
        end
    end
    buildCategoriesMenu()
    loadPage(1)
end)

