-- =================== CACHE DA LISTA ===================
local function SaveEmoteCache(list)
    ensureFolder()
    if writefile then
        pcall(function() writefile(EMOTE_CACHE_FILE, HttpService:JSONEncode(list)) end)
    end
end

local function LoadEmoteCache()
    ensureFolder()
    if isfile and isfile(EMOTE_CACHE_FILE) then
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(EMOTE_CACHE_FILE))
        end)
        if ok and type(decoded) == "table" and #decoded > 0 then
            return decoded
        end
    end
    return nil
end

local function fetchEmotesFromGitHub()
    local ok, result = pcall(function()
        local json = game:HttpGet("https://raw.githubusercontent.com/7yd7/sniper-Emote/refs/heads/test/EmoteSniper.json")
        if json and json ~= "" then
            return HttpService:JSONDecode(json).data or {}
        end
        return nil
    end)
    if ok and result then
        local out = {}
        for _, item in pairs(result) do
            local id = tonumber(item.id)
            if id and id > 0 then
                table.insert(out, {id = id, name = item.name or ("Emote_" .. id)})
            end
        end
        if #out > 0 then return out end
    end
    return nil
end

-- =================== HELPERS ===================
local function smartSearchMatch(name, term)
    if not term or term == "" then return true end
    name = tostring(name):lower()
    term = tostring(term):lower()
    for word in term:gmatch("%S+") do
        if not name:find(word, 1, true) then return false end
    end
    return true
end

local function getEmoteName(id)
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(tonumber(id))
    end)
    if ok and info and info.Name then return info.Name end
    return "Emote_" .. tostring(id)
end

-- =================== CARREGAMENTO BLOQUEANTE (Opção B) ===================
-- Ordem: 1) cache; 2) se não tem, GitHub; 3) se falhar, defaults.
-- Só segue pra criar a GUI depois de ter uma lista definitiva.

local function loadEmotesBlocking()
    -- 1) Cache
    local cached = LoadEmoteCache()
    if cached and #cached > 0 then
        allEmotes = cached
        filteredEmotes = cached
        print("[7yd7] Emotes carregados do cache:", #cached)
        return
    end

    -- 2) GitHub (bloqueante)
    print("[7yd7] Cache vazio, buscando do GitHub...")
    local fresh = fetchEmotesFromGitHub()
    if fresh and #fresh > 0 then
        allEmotes = fresh
        filteredEmotes = fresh
        SaveEmoteCache(fresh)
        print("[7yd7] Emotes carregados do GitHub:", #fresh)
        return
    end

    -- 3) Fallback: API (bloqueante até pegar 1ª página)
    print("[7yd7] GitHub falhou, tentando API...")
    local params = CatalogSearchParams.new()
    params.SearchKeyword = ""
    params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
    params.SortType = Enum.CatalogSortType.RecentlyCreated
    params.Limit = 30
    local ok, pages = pcall(function() return AvatarEditorService:SearchCatalog(params) end)
    if ok and pages then
        local s, list = pcall(function() return pages:GetCurrentPage() end)
        if s and list and #list > 0 then
            local out = {}
            for _, v in ipairs(list) do
                table.insert(out, {id = v.Id or v.AssetId, name = v.Name or "Emote"})
            end
            allEmotes = out
            filteredEmotes = out
            SaveEmoteCache(out)
            print("[7yd7] Emotes carregados da API:", #out)
            return
        end
    end

    -- 4) Último recurso: defaults
    allEmotes = deepCopy(DEFAULT_EMOTES)
    filteredEmotes = deepCopy(DEFAULT_EMOTES)
    print("[7yd7] Usando emotes padrão (fallback total)")
end

loadEmotesBlocking()

-- =================== TRACK ===================
local CurrentTrack = nil
local function LoadTrack(id)
    if CurrentTrack then CurrentTrack:Stop(0.1) end
    local animId
    local ok, result = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
    if ok and result and #result > 0 and result[1]:IsA("Animation") then
        animId = result[1].AnimationId
    else
        animId = "rbxassetid://" .. tostring(id)
    end
    local newAnim = Instance.new("Animation")
    newAnim.AnimationId = animId
    local newTrack = humanoid:LoadAnimation(newAnim)
    newTrack.Priority = Enum.AnimationPriority.Action4
    newTrack.Looped = true
    for _, t in pairs(humanoid.Animator:GetPlayingAnimationTracks()) do
        if t.Priority ~= Enum.AnimationPriority.Action4 then t:Stop(0.1) end
    end
    newTrack:Play(0.1, 1, Settings.Speed)
    CurrentTrack = newTrack
end

RunService.RenderStepped:Connect(function()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        if Settings.StopOnMove and CurrentTrack and CurrentTrack.IsPlaying then
            local moved = (root.Position - lastPosition).Magnitude > 0.1
            local jumped = humanoid and humanoid:GetState() == Enum.HumanoidStateType.Jumping
            if moved or jumped then
                CurrentTrack:Stop(0.1)
                CurrentTrack = nil
            end
        end
        lastPosition = root.Position
    end
end)

